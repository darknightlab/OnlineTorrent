{
  "name": "onlinetorrent-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_MOCK=1 vite",
    "prebuild": "npm run check:webtorrent",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-built-webtorrent.ts",
    "check:webtorrent": "node --test --test-reporter=dot src/player/store/webtorrent-compat.test.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "node --test src/lib/*.test.ts src/player/store/*.test.ts src/player/subs/*.test.ts src/player/timemap/*.test.ts",
    "e2e:chunkstore": "node e2e/chunkstore/run.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.0",
    "artplayer": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-auto-height": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "jassub": "^2.5.23",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "torrent-piece": "^4.0.1",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~6.0.3",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=25"
  }
}
